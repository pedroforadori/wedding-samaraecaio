# Copie para .env.local (cp .env.example .env.local) e preencha.
# Local e produção rodam o mesmo código: só os valores mudam. Em produção
# as mesmas variáveis ficam em Vercel → Settings → Environment Variables.

# Redis (Upstash) — pedidos de presente, RSVP e contador de visitas.
# Na Vercel são injetadas pela integração "Upstash for Redis". Localmente
# usamos o MESMO banco de produção: `npx vercel env pull .env.local` ou
# copie os valores em Vercel → Storage → (banco Upstash) → .env.local.
# Atenção: pedidos de teste aparecem no /admin-noivos — remova-os depois.
# Use um banco Upstash próprio para este site (não o do site Camila & Victor).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Prefixo de todas as chaves no Redis. Padrão: "samaraecaio". Mesmo que o
# banco seja compartilhado por engano, o prefixo evita misturar os dados com
# os de outro site. Ex.: "samaraecaio-dev" para testar localmente sem sujar
# a produção.
REDIS_KEY_PREFIX=

# Pix — chave e titular da conta dos noivos, usados para gerar o QR Code
# "copia e cola" (com e sem valor). Ficam só nas env vars, nunca no código.
# Sem as três variáveis, o Pix some do site e o checkout Pix responde 503.
# PIX_MERCHANT_NAME: até 25 caracteres, sem acentos (vai no payload do Pix).
# PIX_MERCHANT_CITY: até 15 caracteres, sem acentos.
PIX_KEY=
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=

# Stripe — pagamento com cartão na lista de presentes.
# Local: chaves de TESTE (sk_test_…), dashboard.stripe.com/test/apikeys.
# Produção: chaves live (sk_live_…).
# Sem STRIPE_SECRET_KEY o cartão abre o checkout simulado (fora da Vercel
# production) ou aparece como "em breve" (Vercel production).
STRIPE_SECRET_KEY=
# Local: o `whsec_…` impresso por
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# Produção: o signing secret do endpoint /api/stripe/webhook cadastrado no
# dashboard (eventos checkout.session.completed e
# checkout.session.async_payment_succeeded).
STRIPE_WEBHOOK_SECRET=

# Senha única da área /admin-noivos.
ADMIN_NOIVOS_PASSWORD=
